--- playground/.env.example
+++ playground/.env.example
@@ -1,18 +0,0 @@
-# Storage and execution
-COGSCORE_DOCKER_NETWORK=cogscore_online_net
-MAX_UPLOAD_BYTES=2147483648
-MAX_ARCH_CPU=2
-MAX_ARCH_MEMORY=4g
-ARCH_TIMEOUT_SECONDS=120
-PLOT_TIMEOUT_SECONDS=1800
-
-# Bind internal development ports to localhost. Use 0.0.0.0 only when needed.
-COGSCORE_BIND_ADDRESS=127.0.0.1
-
-# Optional dashboard login. Leave password empty for local development.
-COGSCORE_DASHBOARD_USERNAME=researcher
-COGSCORE_DASHBOARD_PASSWORD=
-
-# noVNC
-VNC_PASSWORD=change-this-password
-VNC_PUBLIC_URL=http://localhost:6080/vnc.html?autoconnect=true&resize=scale
