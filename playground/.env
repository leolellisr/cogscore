PROJECT_NAME=cogscore-playground

# Paths
STORAGE_ROOT=/data
LOCAL_STORAGE_ROOT=./data

# Database
POSTGRES_DB=cogscore
POSTGRES_USER=cogscore
POSTGRES_PASSWORD=cogscore
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# API
API_PORT=8000

# Web
WEB_PORT=8501

# VNC
NOVNC_PORT=6080
VNC_PASSWORD=change-me

# Plot defaults
DEFAULT_X_POINTS=50
DEFAULT_SMOOTH_WINDOW=7
DEFAULT_BLEND_RANDOM_SEED=777
DEFAULT_BLEND_NOISE_PCT=0.15

# CogScore repository
COGSCORE_REPO_URL=https://github.com/leolellisr/cogscore
